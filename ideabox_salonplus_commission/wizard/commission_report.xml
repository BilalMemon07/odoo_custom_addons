<odoo>
    <record id="view_commission_report_wizard" model="ir.ui.view">
        <field name="name">commission.report.wizard</field>
        <field name="model">commission.report</field>
        <field name="arch" type="xml">
            <form string="Commission Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>        
                    <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button string="Print" type="object" name="print_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_report_wizard" model="ir.actions.act_window">
        <field name="name">Commission Report</field>
        <field name="res_model">commission.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_commission_report_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_commission_report" name="Commission Report" parent="point_of_sale.menu_point_rep"
            action="action_commission_report_wizard" />
</odoo>