<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ideabox_salonplus_commission.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <button class="btn btn-secondary btn-lg py-5" t-on-click="() => this.onClickPopupSingleFieldCommission()">
                <i class="fa fa-pencil-square me-1" role="img" aria-label="Service Type" title="Service Type"/>Service Type
            </button>
        </xpath>
    </t>
</templates>