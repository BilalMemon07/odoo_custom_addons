<odoo>
    <template id="commission_reports">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size:12px">
                    <div class="row ">
                        <div class="col-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td style="padding: 3px;">
                                        <strong>DATE FROM</strong>
                                    </td>
                                    <td style="padding: 3px;">
                                        <span t-esc="str(others['date_to'])" />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 3px;">
                                        <strong>DATE TO</strong>
                                    </td>
                                    <td style="padding: 3px;">
                                        <span t-esc="str(others['date_to'])" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6">
                            <div>
                                <h3
                                    style="background-color: #f2f2f2;color: #00509e; text-align: center; padding: 5px;">Commission
                                    Report</h3>
                            </div>
                        </div>
                    </div>

                    <table width="100%" style="border-collapse: collapse; margin-top: 10px;">
                        <thead>
                            <tr style="background-color: #00509e; color: white;">
                                <th style="padding: 5px; text-align: center; width:100px;">
                                    <b>Invoice No</b>
                                </th>
                                <th style="padding: 5px; text-align: center; width:100px;">
                                    <b>Invoice Date</b>
                                </th>
                                <th style="padding: 5px; text-align: center; width:100px;">
                                    <b>Client Name</b>
                                </th>
                                <th style="padding: 5px; text-align: center; width:100px;">
                                    <b>Money (Rs.) Brought In</b>
                                </th>
                                <th style="padding: 5px; text-align: center; width:100px;">
                                    <b>Commission</b>
                                </th>
                                <th style="padding: 5px; text-align: center; width:100px;">
                                    <b>Products And Service Details</b>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_amount" t-value="0"/>
                            <t t-set="total_commission" t-value="0"/>
                            <t t-set="subtotal_amount" t-value="0"/>
                            <t t-set="subtotal_commission" t-value="0"/>
                            <t t-set="resource" t-value="''"/>
                            <t t-foreach="data" t-as="value">
                                <t t-if="resource != value['employee_name']">
                                    <tr t-if="resource != ''" style="background-color: #00509e; color: white">
                                        <td/>
                                        <td style="padding: 5px; text-align: center; width: 100px">
                                            <span>Subtotal:</span>
                                        </td>
                                        <td style="padding: 5px; text-align: center; width: 100px">
                                            <span t-esc="subtotal_amount"/>
                                        </td>
                                        <td style="padding: 5px; text-align: center; width: 100px">
                                            <span t-esc="subtotal_commission"/>
                                        </td>
                                        <td/>
                                        <td/>
                                        <t t-set="subtotal_amount" t-value="0"/>
                                        <t t-set="subtotal_commission" t-value="0"/>

                                    </tr>
                                    <tr style=" color: white;background:black">
                                        <t t-set="resource" t-value="value['employee_name']"/>
                                        <td colspan="6" style="text-align: center; font-weight: normal;font-size:14px">
                                            <strong t-esc="resource" class="mt-2"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td style="text-align: center; padding: 4px; font-weight: normal">
                                        <span t-esc="value['order_no']"/>
                                    </td>
                                    <td style="text-align: center; padding: 4px; font-weight: normal">
                                        <span t-esc="value['order_date']"/>
                                    </td>
                                    <td style="text-align: center; padding: 4px; font-weight: normal">
                                        <span t-esc="value['client_name']"/>
                                    </td>
                                    <td style="text-align: center; padding: 4px; font-weight: normal">
                                        <span t-esc="value['order_amount']"/>
                                    </td>
                                    <td style="text-align: center; padding: 4px; font-weight: normal">
                                        <span t-esc="value['commission']"/>
                                    </td>
                                    <td style="text-align: center; padding: 4px; font-weight: normal">
                                        <span t-esc="value['product_name']['en_US']"/>
                                    </td>
                                    <t t-set="total_amount" t-value="total_amount + value['order_amount']"/>
                                    <t t-set="subtotal_amount" t-value="subtotal_amount + value['order_amount']"/>
                                    <t t-set="total_commission" t-value="total_commission + value['commission']"/>
                                    <t t-set="subtotal_commission" t-value="subtotal_commission + value['commission']"/>
                                </tr>
                            </t>
                            <tr style="background-color: #00509e; color: white">
                                        <td/>
                                        <td style="padding: 5px; text-align: center; width: 100px">
                                            <span>Subtotal:</span>
                                        </td>
                                        <td style="padding: 5px; text-align: center; width: 100px">
                                            <span t-esc="subtotal_amount"/>
                                        </td>
                                        <td style="padding: 5px; text-align: center; width: 100px">
                                            <span t-esc="subtotal_commission"/>
                                        </td>
                                        <td/>
                                        <td/>
                                        <t t-set="subtotal_amount" t-value="0"/>
                                        <t t-set="subtotal_commission" t-value="0"/>

                                    </tr>
                            <tr style="background-color: #00509e; color: white">
                                <td/>
                                <td style="padding: 5px; text-align: center; width: 100px">
                                    <span>Total:</span>
                                </td>
                                <td style="padding: 5px; text-align: center; width: 100px">
                                    <span t-esc="total_amount"/>
                                </td>
                                <td style="padding: 5px; text-align: center; width: 100px">
                                    <span t-esc="total_commission"/>
                                </td>
                                <td />
                                <td />
                            </tr>
                        </tbody>


                    </table>

                </div>
            </t>

        </t>
    </template>
</odoo>