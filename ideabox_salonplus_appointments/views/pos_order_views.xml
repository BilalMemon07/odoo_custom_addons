<odoo>
    <data>
        <record id="view_pos_order_form_inherit_appointments" model="ir.ui.view">
            <field name="name">pos.order.form.appointments</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_appointments"
                            type="object"
                            string="Appointments"
                            icon="fa-calendar"
                            class="oe_stat_button"
                            invisible="appointment_count == 0">
                        <field name="appointment_count" widget="statinfo" string="Appointments"/>
                    </button>
                </xpath>
                <xpath expr="/form/sheet/notebook/page/field[@name='lines']/list/field[@name='full_product_name']" position="after">
                    <field name="resource_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

