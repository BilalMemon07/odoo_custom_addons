<?xml version="1.0" encoding="UTF-8"?>
<!-- Muhammad Bilal -->
<templates id="template" xml:space="preserve">
    <t t-name="ideabox_salonplus_appointments.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="inside" >
            <t t-if="line.resource_name">
                <li class="border rounded fw-bolder px-2 py-1 me-1 text-white shadow-sm" style="background-color:#374151;"> 
                        <i class="fa fa-user me-1" role="img" aria-label="Resource" title="Resource"/>
                        <t t-esc="line.resource_name" />
                    <br/>
                </li>
            </t>
        </xpath>
    </t>
</templates>


