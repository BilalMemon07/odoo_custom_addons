<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sh_allow_multi_user_res_config_settings_form" model="ir.ui.view">
        <field name="name">sh.allow.multi.user.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">

                <block title="Allow Multiple Users" name="allow_multiple_users">
                    <setting id="allow_multiple_users_id" help="Allow Multiple User ">
                        <field name="sh_allow_multi_user" />
                    </setting>
                </block>


                <block
                    title="Allow Default Description"
                    name="allow_default_description"
                >
                    <setting
                        id="allow_default_description_id"
                        help="Allow Default Description"
                    >
                        <field name="sh_allow_without_description" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
