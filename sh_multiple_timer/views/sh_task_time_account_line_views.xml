<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sh_project_task_time_account_line_form_view" model="ir.ui.view">
        <field name="name">sh.task.time.account.line</field>
        <field name="model">sh.task.time.account.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id" required="True" />
                        <field name="name" string="Enter Task Description" />
                    </group>
                    <div invisible="not warning" class="alert alert-warning">
                        <field name="warning" />
                    </div>
                    <group invisible="not employee_id or warning">
                        <group>
                            <field name="start_date" />
                            <field name="duration" widget="float_time" force_save="1"/>
                        </group>
                        <group>
                            <field name="end_date" />
                            <field name="company_id" invisible='1' />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        string="End Task"
                        name="end_task"
                        type="object"
                        default_focus="1"
                        class="btn-primary"
                        invisible="warning"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
