<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shift_detail_report_wizard" model="ir.ui.view">
        <field name="name">Shift Details Report</field>
        <field name="model">shift.detail.report</field>
        <field name="arch" type="xml">
            <form string="Shift Details Report">
                <group>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>

                </group> 
                <footer>
                    <button name="print_report" type="object" string="Print" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="shift_detail_report_action" model="ir.actions.act_window">
        <field name="name">Shift Details Report</field>
        <field name="res_model">shift.detail.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="shift_detail_report_menu"
            name="Shift Details Report"
            parent="hr.hr_menu_hr_reports"
            action="shift_detail_report_action"
            sequence="310"
/>
</odoo>