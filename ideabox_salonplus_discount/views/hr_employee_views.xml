<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Inheriting form view of hr employee-->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.pos.discount.manager</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="before">
                <field name="limited_discount_percentage"/>
                <field name="limited_discount_amount"/>
            </xpath>
        </field>
    </record>
</odoo>
