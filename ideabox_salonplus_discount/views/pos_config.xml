    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_order_list</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_inventory_section" position="after">
                <block title="Retail Configurations">
                    <!-- pos discount -->
                    <div style="font-size: 15px; font-weight: 600;"> POS Discount </div>
                    
                    <setting>
                        <field name="pos_allow_order_line_discount" />
                    </setting>
                    <setting>
                        <field name="pos_allow_global_discount" />
                    </setting>
                    <!-- Product Suggestion -->
                </block>
            </block>
        </field>
    </record>
