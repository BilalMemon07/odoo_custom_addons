<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="product_quantity_min_qty"
        inherit_id="website_sale.product_quantity"
        customize_show="True"
        name="Select Quantity"
    >
        <xpath expr="//input[@name='add_qty']" position="replace">
            <input
                type="text"
                class="form-control quantity text-center qty_add"
                data-min="1"
                name="add_qty"
                t-att-value="combination_info['default_min_qty'] or 1"
            />
        </xpath>
    </template>

    <template
        id="product_quantity_hidden_"
        inherit_id="website_sale.product"
        name="Hidden Quantity"
    >
        <xpath expr="//div[@id='add_to_cart_wrap']" position="before">
            <input
                type="hidden"
                class="form-control"
                name="min_qty"
                t-att-value="combination_info['default_min_qty'] or 1"
            />
        </xpath>
    </template>

    <template
        id="cart_lines_min_qty"
        inherit_id="website_sale.cart_lines"
        customize_show="True"
        name="Select Quantity"
    >
        <xpath expr="//div[@name='website_sale_cart_line_quantity']" position="after">
            <input
                type="hidden"
                id="min_qty_"
                t-attf-class="min_qty_#{line.id}"
                name="min_qty"
                t-att-value="line.product_id.min_qty or 1"
            />
        </xpath>
    </template>

    <template
        id="produc_hidden_shortcut_buton"
        inherit_id="website_sale.products_item"
        name="Hidden Quantity"
    >
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="inside">
            <input
                type="hidden"
                class="form-control set_min_qty"
                name="min_qty"
                t-attf-value="combination_info['default_min_qty'] or 1"
            />
        </xpath>
    </template>
</odoo>
