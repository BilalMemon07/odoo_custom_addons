<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resource_schedule_report_wizard" model="ir.ui.view">
        <field name="name">Resource Schedule Report</field>
        <field name="model">resource.schedule.report</field>
        <field name="arch" type="xml">
            <form string="Resource Schedule Report">
                <group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group> 
                <footer>
                    <button name="print_report" type="object" string="Print" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="resource_schedule_report_action" model="ir.actions.act_window">
        <field name="name">Resource Schedule Report</field>
        <field name="res_model">resource.schedule.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="resource_schedule_report_menu"
            name="Resource Schedule Report"
            parent="hr.hr_menu_hr_reports"
            action="resource_schedule_report_action"
            sequence="310"
/>
</odoo>