<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="daily_sales_report_wizard" model="ir.ui.view">
        <field name="name">Daily Sales Report</field>
        <field name="model">daily.sales.report</field>
        <field name="arch" type="xml">
            <form string="Daily Sales Report">
                <group>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="payment_status" />
                    </group>

                </group> 
                <footer>
                    <button name="print_report_word" type="object" string="Print" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="daily_sales_report_action" model="ir.actions.act_window">
        <field name="name">Daily Sales Report</field>
        <field name="res_model">daily.sales.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="daily_sales_report_menu"
            name="Daily Sales Report"
            parent="point_of_sale.menu_point_rep"
            action="daily_sales_report_action"
            sequence="310"
/>
</odoo>