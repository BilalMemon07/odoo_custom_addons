<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Karachi Area Views -->
    <record id="view_karachi_area_list" model="ir.ui.view">
        <field name="name">karachi.area.list</field>
        <field name="model">karachi.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_karachi_area_form" model="ir.ui.view">
        <field name="name">karachi.area.form</field>
        <field name="model">karachi.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_karachi_area" model="ir.actions.act_window">
        <field name="name">Karachi Areas</field>
        <field name="res_model">karachi.area</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- Karachi Area Block Views -->
    <record id="view_karachi_area_block_list" model="ir.ui.view">
        <field name="name">karachi.area.block.list</field>
        <field name="model">karachi.area.block</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="area_id"/>
            </list>
        </field>
    </record>

    <record id="view_karachi_area_block_form" model="ir.ui.view">
        <field name="name">karachi.area.block.form</field>
        <field name="model">karachi.area.block</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="area_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_karachi_area_block_search" model="ir.ui.view">
        <field name="name">karachi.area.block.search</field>
        <field name="model">karachi.area.block</field>
        <field name="arch" type="xml">
            <search>
                <group string="Group By" expand="0">
                    <filter string="Area" name="group_by_area_id" context="{'group_by': 'area_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="action_karachi_block_area" model="ir.actions.act_window">
        <field name="name">Karachi Areas Block</field>
        <field name="res_model">karachi.area.block</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_area_id': 1}</field>
        <field name="view_id" ref="view_karachi_area_block_list"/>

    </record>

    <menuitem id="menu_karachi_area" name="Area" parent="contacts.res_partner_menu_config" action="action_karachi_area" sequence="7"/>
    <menuitem id="menu_karachi_area_block" name="Area Block" parent="contacts.res_partner_menu_config" action="action_karachi_block_area" sequence="8"/>

</odoo>